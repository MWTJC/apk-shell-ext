// apkinfo.exe 的资源：只有 VERSIONINFO（M5）。
// 这是会被杀软和"任务管理器 → 详细信息"看到的进程，版本信息要齐。
#pragma code_page(65001)
#include <windows.h>
#include "../version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APKSX_VERSION_MAJOR,APKSX_VERSION_MINOR,APKSX_VERSION_PATCH,APKSX_VERSION_BUILD
 PRODUCTVERSION APKSX_VERSION_MAJOR,APKSX_VERSION_MINOR,APKSX_VERSION_PATCH,APKSX_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", APKSX_PUBLISHER
            VALUE "FileDescription", "Package metadata parser (JSON worker)"
            VALUE "FileVersion", APKSX_VERSION_FULL
            VALUE "InternalName", "apkinfo"
            VALUE "OriginalFilename", "apkinfo.exe"
            VALUE "ProductName", APKSX_PRODUCT_NAME
            VALUE "ProductVersion", APKSX_VERSION_FULL
            VALUE "LegalCopyright", "MIT licensed"
            VALUE "Comments", "Out-of-process parser used by the property page (ADR-0003)."
        END
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", APKSX_PUBLISHER
            VALUE "FileDescription", "安装包元数据解析器（JSON worker）"
            VALUE "FileVersion", APKSX_VERSION_FULL
            VALUE "InternalName", "apkinfo"
            VALUE "OriginalFilename", "apkinfo.exe"
            VALUE "ProductName", APKSX_PRODUCT_NAME
            VALUE "ProductVersion", APKSX_VERSION_FULL
            VALUE "LegalCopyright", "MIT licensed"
            VALUE "Comments", "属性页用的进程外解析器（ADR-0003）。"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
        VALUE "Translation", 0x804, 1200
    END
END
