// apkprop.dll resources: property page template + page title + VERSIONINFO.
// The template has no controls at all: the whole page is owner-drawn
// (docs/m3-property-page.md section 3). 240x240 DLU is about 420x450 px at 96 DPI.
#pragma code_page(65001)
#include <windows.h>
#include "../version.h"

// 与 src/propsheet/apkprop.h 保持一致（RC 只认 #define）
#define IDD_APKPROP 101

IDD_APKPROP DIALOGEX 0, 0, 240, 240
STYLE DS_SETFONT | DS_FIXEDSYS | WS_CHILD | WS_CLIPCHILDREN
EXSTYLE WS_EX_CONTROLPARENT
FONT 9, "Segoe UI", 400, 0, 0x1
BEGIN
END

// 页面标题不放在资源里：由 src/core/i18n.cpp 按系统语言给出（apkprop.h 的 IDS_PAGE_TITLE 已废弃）

VS_VERSION_INFO VERSIONINFO
 FILEVERSION APKSX_VERSION_MAJOR,APKSX_VERSION_MINOR,APKSX_VERSION_PATCH,APKSX_VERSION_BUILD
 PRODUCTVERSION APKSX_VERSION_MAJOR,APKSX_VERSION_MINOR,APKSX_VERSION_PATCH,APKSX_VERSION_BUILD
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", APKSX_PUBLISHER
            VALUE "FileDescription", "APK / HAP package info property page"
            VALUE "FileVersion", APKSX_VERSION_FULL
            VALUE "InternalName", "apkprop"
            VALUE "OriginalFilename", "apkprop.dll"
            VALUE "ProductName", APKSX_PRODUCT_NAME
            VALUE "ProductVersion", APKSX_VERSION_FULL
            VALUE "LegalCopyright", "MIT licensed"
        END
        BLOCK "080404b0"
        BEGIN
            VALUE "CompanyName", APKSX_PUBLISHER
            VALUE "FileDescription", "安装包信息属性页（APK / HAP）"
            VALUE "FileVersion", APKSX_VERSION_FULL
            VALUE "InternalName", "apkprop"
            VALUE "OriginalFilename", "apkprop.dll"
            VALUE "ProductName", APKSX_PRODUCT_NAME
            VALUE "ProductVersion", APKSX_VERSION_FULL
            VALUE "LegalCopyright", "MIT licensed"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
        VALUE "Translation", 0x804, 1200
    END
END